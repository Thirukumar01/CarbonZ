# CarbonZ Environment Configuration
# Duplicate this file to .env.local for local development.

# Supabase Public API Configuration (Client-side accessible)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Server-Only Secret Key (Privileged operations, server-side only, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Demo Mode fallback flag (allows rich browsing of mock/demo data when real Supabase credentials are not yet configured)
NEXT_PUBLIC_ENABLE_DEMO_DATA="true"
